{
  "name": "global-product-master-demo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "lint": "eslint dist/solution-labs/*.js scripts/*.cjs",
    "format:check": "prettier --check dist/solution-labs/* dist/master-demo/*.html scripts/*.cjs",
    "format": "prettier --write dist/solution-labs/* dist/master-demo/*.html scripts/*.cjs",
    "test": "node --test tests-js/*.test.cjs",
    "architecture": "node scripts/build-solution-diagrams.cjs --check",
    "check": "npm run lint && npm run format:check && npm test && npm run architecture"
  },
  "devDependencies": {
    "eslint": "^10.12.0",
    "prettier": "^3.9.10"
  }
}
